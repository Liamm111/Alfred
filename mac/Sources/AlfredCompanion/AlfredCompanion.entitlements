<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <!-- Hardened runtime (required for notarization) is enabled at signing time with --options runtime. -->
  <key>com.apple.security.device.audio-input</key><true/>
  <!-- Screen Recording needs no entitlement: it is a TCC permission. No network client entitlement needed yet (sandbox is OFF for Developer ID). -->
</dict></plist>
