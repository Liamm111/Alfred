{
  "name": "connected_without_media",
  "description": "Connected callback never proves media: the session fails after the timeout.",
  "session_id": "11111111-1111-4111-8111-111111111111",
  "owner_id": "22222222-2222-4222-8222-222222222222",
  "steps": [
    {
      "advance_ms": 0,
      "do": {
        "type": "DETECT",
        "meeting_uuid": "synthetic-meeting-001"
      },
      "accepted": true,
      "expect_state": "DETECTED"
    },
    {
      "advance_ms": 100,
      "do": {
        "type": "REQUEST_PERMISSION"
      },
      "accepted": true,
      "expect_state": "PERMISSION"
    },
    {
      "advance_ms": 100,
      "do": {
        "type": "PERMISSION_GRANTED",
        "source_epoch": 1,
        "stream_id": "synthetic-stream-001"
      },
      "accepted": true,
      "expect_state": "CONNECTING"
    },
    {
      "advance_ms": 50,
      "do": {
        "type": "CONNECTED"
      },
      "accepted": true,
      "expect_state": "CONNECTING",
      "expect_effects": [
        "connected_callback_is_not_media"
      ]
    },
    {
      "advance_ms": 8000,
      "do": {
        "type": "TICK"
      },
      "accepted": true,
      "expect_state": "CONNECTING",
      "expect_effects": [
        "alert_raised"
      ]
    },
    {
      "advance_ms": 12000,
      "do": {
        "type": "TICK"
      },
      "accepted": true,
      "expect_state": "FAILED",
      "expect_effects": [
        "stop_sources"
      ]
    }
  ],
  "expect_final": {
    "state": "FAILED",
    "outcome": "failed"
  }
}
