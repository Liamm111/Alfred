  "owner_id": "22222222-2222-4222-8222-222222222222",
  "steps": [
    {
      "advance_ms": 0,
      "do": {
        "type": "DETECT",
        "meeting_uuid": "synthetic-meeting-001"
      },
      "accepted": true,
      "expect_state": "DETECTED"
    },
    {
      "advance_ms": 100,
      "do": {
        "type": "REQUEST_PERMISSION"
