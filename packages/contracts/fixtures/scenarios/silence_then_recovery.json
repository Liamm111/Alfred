      },
      "accepted": true,
      "expect_state": "DEGRADED",
      "expect_effects": [
        "request_recovery"
      ]
    },
    {
      "advance_ms": 10,
      "do": {
        "type": "RECOVERY_STARTED",
        "source_epoch": 2
      },
      "accepted": true,
      "expect_state": "RECOVERING"
    },
    {
      "advance_ms": 10,
      "do": {
        "type": "CONNECTED"
      },
      "accepted": true,
      "expect_state": "RECOVERING"
    },
    {
      "advance_ms": 300,
      "do": {
        "type": "PACKET",
        "modality": "audio",
        "seq": 0,
        "source_epoch": 2,
        "payload_bytes": 320,
        "queued_ms": 0,
        "source_lag_ms": 40
      },
      "accepted": true,
      "expect_state": "LIVE_AUDIO"
