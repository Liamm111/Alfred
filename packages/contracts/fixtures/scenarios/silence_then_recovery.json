        "source_epoch": 1,
        "payload_bytes": 320,
        "queued_ms": 0,
        "source_lag_ms": 40
      },
      "accepted": true,
      "expect_state": "LIVE_AUDIO"
    },
    {
      "advance_ms": 3500,
      "do": {
        "type": "TICK"
      },
      "accepted": true,
      "expect_state": "DEGRADED",
      "expect_effects": [
        "gap_opened"
      ]
    },
    {
      "advance_ms": 10000,
      "do": {
