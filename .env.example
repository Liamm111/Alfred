# Copy to .env (never commit .env). No real values here. Secrets live in the server environment only.
APP_ENV=development            # development | test | staging | production
MOCK_MODE=false                # true|false. true is FORBIDDEN when APP_ENV=production. Enables /dev/demo routes + simulated provider.
LOG_LEVEL=info
DATABASE_URL=postgres://alfred:alfred@localhost:5432/alfred
API_HOST=127.0.0.1
API_PORT=4000
PUBLIC_WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:4000   # used by the Next.js rewrite (server-side only)
HEALTH_TOKEN=                      # required (>=24 chars) in staging/production for /health/ready
AUTH_SECRET=                       # >=32 chars, required in staging/production (generate: openssl rand -hex 32)
EMAIL_TRANSPORT=disabled           # disabled | file (dev/test only) | smtp (required in staging/production)
EMAIL_FROM=Assistant IA <no-reply@localhost>
EMAIL_OUTBOX_DIR=                  # only for EMAIL_TRANSPORT=file (writes magic links to disk: NEVER in production)
SMTP_URL=                          # smtp://user:pass@host:587 — server-side secret
AUTH_MAGIC_LINK_MAX_PER_MIN=5      # >5 only allowed outside staging/production
TRUST_PROXY_HOPS=0                 # trusted reverse proxies in front of the API (needed for per-client rate limits)
