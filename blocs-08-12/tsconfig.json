{
  "compilerOptions": {
    "target": "ES2023", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "noEmit": true, "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true, "skipLibCheck": true,
    "noUncheckedIndexedAccess": true, "types": ["node"]
  },
  "include": ["src", "tests"]
}
