{
  "name": "ai-course-assistant",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --no-bail typecheck",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm --filter @alfred/web test:e2e",
    "build": "pnpm -r build",
    "migrate:up": "pnpm --filter @alfred/db migrate:up",
    "migrate:down": "pnpm --filter @alfred/db migrate:down",
    "db:generate": "pnpm --filter @alfred/db generate",
    "secrets:scan": "node scripts/secrets-scan.mjs",
    "check:prod-bundle": "node scripts/check-prod-bundle.mjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "fast-check": "^4.10.2",
    "globals": "^16.5.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
